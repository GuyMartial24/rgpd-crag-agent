# =====================================================================
# Exemple de fichier .env : copiez-le en « .env » puis adaptez-le.
#   cp .env.example .env
# Le fichier .env est ignoré par git (il peut contenir des réglages
# propres à votre machine). Toutes les variables sont facultatives :
# sans elles, les valeurs par défaut de src/config.py s'appliquent.
# =====================================================================

# --- Sur le VPS uniquement : ajoute docker-compose.vps.yml (Ollama
# dédié et prioritaire sur le processeur). À laisser commenté en local.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml

# --- Modèles Ollama
# LLM_MODEL=qwen2.5:3b
# Changer de modèle d'embedding impose de reconstruire la base :
#   python -m src.ingest --reset
# EMBEDDING_MODEL=bge-m3

# --- Délai maximal d'un appel à Ollama (secondes)
# REQUEST_TIMEOUT=120

# --- Ports publiés par Docker
# API_PORT=8000
# FRONTEND_PORT=8080

# --- Sites autorisés à appeler l'API depuis le navigateur (JSON)
# CORS_ORIGINS=["https://mon-site.fr"]
